{
  "name": "email-lens",
  "version": "0.1.0",
  "description": "Free, local email client compatibility checker and cross-device previewer. Paste HTML, upload .eml, or connect Mailpit, MailHog or Mailtrap.",
  "type": "module",
  "license": "MIT",
  "bin": { "email-lens": "bin/email-lens.mjs" },
  "scripts": {
    "start": "node bin/email-lens.mjs serve",
    "check": "node bin/email-lens.mjs check",
    "update-data": "node bin/email-lens.mjs update-data",
    "browsers": "playwright install chromium webkit firefox",
    "test": "node --test test/*.test.mjs"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "css-what": "^7.0.0",
    "htmlparser2": "^10.0.0",
    "mailparser": "^3.9.0",
    "postcss": "^8.5.0"
  },
  "optionalDependencies": {
    "playwright": "1.63.0"
  }
}
